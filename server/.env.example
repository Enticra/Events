# Copy to server/.env and fill in. Never commit the real .env.

PORT=4000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/popcorn_events
# Set to true for hosted Postgres that requires TLS (Neon, Supabase, Render, RDS…)
DATABASE_SSL=false
ADMIN_PASSWORD=change-me
# Long random string, so admin logins survive server restarts
AUTH_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_… while testing)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or Dashboard → Developers → Webhooks in production
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of the site, used for Stripe's return links.
# Leave empty in development (the requesting site is used); set it in production.
PUBLIC_URL=
